# CHAKRISEBA BD — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development or set in Vercel/Production dashboard

# 1. Database (PostgreSQL / Supabase / Neon / AWS RDS)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Server Authentication & Session Security
SESSION_SECRET=super_secret_cryptographic_key_at_least_32_characters_long
SESSION_EXPIRY_DAYS=7
NODE_ENV=production

# 3. Private Object Storage (AWS S3 / Supabase Private Storage)
STORAGE_PROVIDER=supabase # Options: supabase, s3, local
STORAGE_BUCKET_NAME=candidate-private-vault
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# 4. Payment Gateway (Sandbox/Production)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_SANDBOX=true

# 5. SMS Gateway Credentials (Pending Provider Agreement)
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=CHAKRISEBABD
