{
  "name": "chakri-sheba",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "node -r ./scripts/preload-env.js ./node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "brain": "node ai-brain/cli.js",
    "brain:worker": "node ai-brain/worker.js",
    "brain:test": "node ai-brain/cli.js test",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "validate": "tsc --noEmit && next lint",
    "sync:alljobs": "node scripts/fetch_and_populate_alljobs.js",
    "spider:browser": "node scripts/spider/browser_agent.js",
    "audit": "node scripts/test_audit_api.js",
    "test": "npm run typecheck",
    "test:browser": "node scripts/browser_verify.js"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
