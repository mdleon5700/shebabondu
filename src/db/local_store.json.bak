    "home": {
      "id": "home",
      "slug": "/home-cms-draft",
      "title": "হোমপেজ — চাকরি সেবা",
      "metaTitle": "চাকরি সেবা | সরকারি ও বেসরকারি চাকরি আবেদন পোর্টাল ২০২৬",
      "metaDescription": "১-ক্লিকে চাকরির আবেদন, টেলিটক অটো-ফিল ও নির্ভুল ফর্ম পূরণ সেবা।",
      "status": "published",
      "version": 8,
      "isSystemPage": true,
      "updatedAt": "2026-10-30T03:04:03.618Z",
      "publishedAt": "2026-10-30T03:04:03.618Z",
      "sections": [
        {
          "id": "sec-hero",
          "type": "hero",
          "title": "সরকারি ও ব্যাংক চাকরির নির্ভুল আবেদন সেবা",
          "subtitle": "টেলিটক আবেদনের ঝামেলা শেষ। ঘরে বসেই ১-ক্লিকে নিশ্চিত করুন নির্ভুল আবেদন ও দ্রুত স্লিপ ডেলিভারি।",
          "content": {
            "ctaText": "চলতি সার্কুলার দেখুন",
            "ctaUrl": "/jobs",
            "badge": "⚡ ২০২৬ এর সর্বশেষ নিয়োগ সার্কুলার"
          },
          "style": {
            "backgroundColor": "#064e3b",
            "textColor": "#ffffff",
            "paddingY": "xl",
            "textAlign": "center"
          },
          "isVisible": true
        },
        {
          "id": "sec-features",
          "type": "features",
          "title": "কেন চাকরি সেবা ব্যবহার করবেন?",
          "subtitle": "আমাদের প্ল্যাটফর্মের বিশ্বস্ত ও আধুনিক সেবাসমূহ",
          "content": {
            "items": [
              {
                "title": "১০০% নির্ভুল টেলিটক ফরম পূরণ",
                "desc": "অভিজ্ঞ ব্যাকঅফিস টিম দ্বারা অফিসিয়াল সাইটে প্রমিত ফর্ম পূরণ।"
              },
              {
                "title": "৩০০×৩০০ ছবি ও স্বাক্ষর কনভার্ট",
                "desc": "টেলিটকের কঠোর মেগাবাইট ও পিক্সেল সাইজ অটোমেটিক ফরম্যাটিং।"
              },
              {
                "title": "এসএমএস ও ট্র্যাকিং অ্যালার্ট",
                "desc": "পরীক্ষার তারিখ ও প্রবেশপত্র আসার সাথে সাথে ইনস্ট্যান্ট নোটিফিকেশন।"
              }
            ]
          },
          "style": {
            "backgroundColor": "#064e3b",
            "textColor": "#ffffff",
            "paddingY": "lg",
            "columns": 3
          },
          "isVisible": true
        }
      ],
