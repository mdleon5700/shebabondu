    "contact-us": {
      "id": "contact-us",
      "slug": "/contact-us",
      "title": "সাহায্য ও যোগাযোগ — চাকরি সেবা",
      "metaTitle": "সাহায্য ও যোগাযোগ | চাকরি সেবা বিডি",
      "metaDescription": "আবেদন সংক্রান্ত যেকোনো জিজ্ঞাসা, পেমেন্ট ভেরিফিকেশন বা সহযোগিতার জন্য হেল্পলাইনে যোগাযোগ করুন।",
      "status": "published",
      "version": 7,
      "isSystemPage": true,
      "updatedAt": "2026-10-30T03:04:04.307Z",
      "publishedAt": "2026-10-30T03:04:04.307Z",
      "sections": [
        {
          "id": "sec-contact-hero",
          "type": "hero",
          "title": "যেকোনো প্রয়োজনে আমরা আপনার পাশে আছি",
          "subtitle": "আবেদন সংক্রান্ত যেকোনো জিজ্ঞাসা, পেমেন্ট ভেরিফিকেশন বা সহযোগিতার জন্য সরাসরি হেল্পলাইনে কল করুন বা হোয়াটসঅ্যাপে মেসেজ দিন।",
          "content": {
            "badge": "২৪/৭ সাপোর্ট ও সহায়তা"
          },
          "style": {
            "backgroundColor": "#064e3b",
            "textColor": "#ffffff",
            "paddingY": "lg",
            "textAlign": "center"
          },
          "isVisible": true
        },
        {
          "id": "sec-contact-features",
          "type": "features",
          "title": "আমাদের সাপোর্ট চ্যানেলসমূহ",
          "subtitle": "দ্রুত সেবা পেতে নিচের যেকোনো মাধ্যমে যোগাযোগ করুন",
          "content": {
            "items": [
              {
                "title": "জরুরি হেল্পলাইন",
                "desc": "সরাসরি ফোনে কথা বলুন সকাল ৯:০০ হতে রাত ১০:০০ পর্যন্ত।"
              },
              {
                "title": "WhatsApp চ্যাট সাপোর্ট",
                "desc": "২৪ ঘণ্টার মধ্যে দ্রুত ও নির্ভুল সমাধান পেতে মেসেজ দিন।"
              },
              {
                "title": "টেলিগ্রাম চ্যানেল",
                "desc": "ইনস্ট্যান্ট চাকরির আপডেট ও সার্কুলার অ্যালার্ট পেতে যুক্ত থাকুন।"
              }
            ]
          },
          "style": {
            "backgroundColor": "#ffffff",
            "textColor": "#0f172a",
            "paddingY": "md",
            "columns": 3
          },
          "isVisible": true
        }
      ],
