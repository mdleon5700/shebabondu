      "isSystemPage": true,
      "updatedAt": "2026-10-30T03:04:05.269Z",
      "publishedAt": "2026-10-30T03:04:05.269Z",
      "sections": [
        {
          "id": "sec-disclaimer-hero",
          "type": "hero",
