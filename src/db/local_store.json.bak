      "revisions": [
        {
          "id": "rev-job-ai-bcic-14936-v1-1794126703488",
          "draftId": "job-ai-bcic-14936",
          "versionNumber": 1,
          "timestamp": "2026-11-08T08:31:43.488Z",
          "author": "ADMIN-SUPER",
          "changeSummary": "প্রাথমিক খসড়া তৈরি",
          "articleSnapshot": {
            "title": "বাংলাদেশ কেমিক্যাল ইন্ডাস্ট্রিজ কর্পোরেশন (বিসিআইসি) নিয়োগ বিজ্ঞপ্তি ২০২৬ — বাংলাদেশ কেমিক্যাল ইন্ডাস্ট্রিজ কর্পোরেশন (বিসিআইসি) Job Circular 2026",
            "bengaliMarkdown": "বাংলাদেশ কেমিক্যাল ইন্ডাস্ট্রিজ কর্পোরেশন (বিসিআইসি) সম্প্রতি ২০২৬ সালের জন্য রাজস্ব খাতভুক্ত স্থায়ী শূন্যপদে দক্ষ, যোগ্য ও উদ্যমী জনবল নিয়োগের লক্ষ্যে অফিসিয়াল নিয়োগ বিজ্ঞপ্তি প্রকাশ করেছে। উক্ত প্রতিষ্ঠানে বিভিন্ন ক্যাটাগরিতে মোট ৩৯০ টি পদে সরাসরি জনবল নিয়োগের জন্য যোগ্য বাংলাদেশি নাগরিকদের নিকট থেকে অনলাইনে দরখাস্ত আহ্বান করা হচ্ছে।\n\nবিজ্ঞপ্তি অনুযায়ী, এই নিয়োগ প্রক্রিয়ায় সহকারী ব্যবস্থাপক (প্রশাসন) (২২ জন), সহকারী রসায়নবিদ (৬২ জন), সহকারী প্রকৌশলী (বিদ্যুৎ) (১৩ জন), কারিগরী কর্মকর্তা (১৩ জন), সহকারী অপারেশন অফিসার (৩ জন) সহ মোট ১৯টি পদে আবেদন গ্রহণ করা হবে। পদভেদে ন্যূনতম শিক্ষাগত যোগ্যতা স্বীকৃত বিশ্ববিদ্যালয় হতে সংশ্লিষ্ট বিষয়ে স্নাতক (সম্মান) বা স্নাতকোত্তর ডিগ্রি নির্ধারণ করা হয়েছে এবং সাধারণ প্রার্থীদের বয়সসীমা ১৮ হতে ৩২ বছরের মধ্যে হতে হবে (বীর মুক্তিযোদ্ধা কোটা ও অন্যান্য সংরক্ষিত কোটায় সরকারি বিধি অনুযায়ী শিথিলযোগ্য)।\n\nনির্বাচিত প্রার্থীরা জাতীয় বেতন স্কেল ২০১৫ এর আওতায় আকর্ষণীয় মূল বেতনের পাশাপাশি সরকারি বিধি মোতাবেক বাড়িভাড়া ভাতা, চিকিৎসা ভাতা, যাতায়াত ভাতা ও উৎসব ভাতা প্রাপ্য হবেন। আগ্রহী প্রার্থীদের নির্ধারিত সময়ের মধ্যে টেলিটকের অফিশিয়াল অনলাইন পোর্টাল (http://bcic.teletalk.com.bd) ব্যবহার করে সঠিক নিয়মে আবেদন ফরম পূরণ ও ফি জমা দেওয়ার পরামর্শ প্রদান করা হচ্ছে।",
            "faqItems": [
              {
                "question": "বাংলাদেশ কেমিক্যাল ইন্ডাস্ট্রিজ কর্পোরেশন (বিসিআইসি) নিয়োগ বিজ্ঞপ্তি ২০২৬-এর আবেদনের শেষ তারিখ কবে?",
                "answer": "বাংলাদেশ কেমিক্যাল ইন্ডাস্ট্রিজ কর্পোরেশন (বিসিআইসি)-এর অফিসিয়াল সার্কুলার অনুসারে আবেদনের শেষ তারিখ ও সময়: ১২ নভেম্বর ২০২৬।"
              },
              {
                "question": "এই নিয়োগে আবেদন করার ন্যূনতম শিক্ষাগত যোগ্যতা কী?",
                "answer": "উক্ত বিজ্ঞপ্তিতে আবেদনের জন্য ন্যূনতম শিক্ষাগত যোগ্যতা: স্বীকৃত বিশ্ববিদ্যালয় হতে সংশ্লিষ্ট বিষয়ে স্নাতক (সম্মান) বা স্নাতকোত্তর ডিগ্রি।"
              },
              {
                "question": "আবেদন ফি কত টাকা এবং কীভাবে দিতে হবে?",
                "answer": "আবেদন ফি: বিজ্ঞপ্তিতে উল্লেখ নেই। অনলাইনে আবেদন ফর্ম পূরণের পর টেলিটক প্রিপেইড মোবাইল বা নির্দিষ্ট মাধ্যমে ফি পরিশোধ করতে হবে।"
              },
              {
                "question": "কোন ওয়েবসাইটে গিয়ে আবেদন ফর্ম পূরণ করতে হবে?",
                "answer": "আগ্রহী প্রার্থীদের অফিসিয়াল ওয়েবসাইট বিজ্ঞপ্তিতে উল্লেখ নেই এ গিয়ে সরাসরি অনলাইনে আবেদন করতে হবে।"
              },
              {
                "question": "বয়সসীমা কত এবং কোটা প্রার্থীদের ক্ষেত্রে কোনো ছাড় আছে কি?",
                "answer": "সাধারণ প্রার্থীদের জন্য নির্ধারিত বয়সসীমা 18 থেকে 32 বছর। কোটাভুক্ত প্রার্থীদের ক্ষেত্রে সরকারি বিধি অনুযায়ী ছাড় প্রযোজ্য।"
              }
            ]
          },
