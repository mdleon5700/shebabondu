      "positions": [
        {
          "id": "pos-15121",
          "title": "ইউনিয়ন পরিষদ প্রশাসনিক কর্মকর্তা",
          "grade": "১০ম গ্রেড",
          "posts": 5,
          "vacancies": 5,
          "salary": "১৬,০০০ - ৩৮,৬৪০/- টাকা",
          "minEducation": "স্বীকৃত বিশ্ববিদ্যালয় হতে স্নাতক ডিগ্রি অথবা সরকার স্বীকৃত পলিটেকনিক ইনস্টিটিউট হতে ৪ বছর মেয়াদি ডিপ্লোমা-ইন-ইঞ্জিনিয়ারিং",
          "govtFee": 223
        }
      ],
      "bengaliDescription": "জেলা প্রশাসকের কার্যালয়, রাজবাড়ী সম্প্রতি ২০২৬ সালের জন্য রাজস্ব খাতভুক্ত স্থায়ী শূন্যপদে দক্ষ, যোগ্য ও উদ্যমী জনবল নিয়োগের লক্ষ্যে অফিসিয়াল নিয়োগ বিজ্ঞপ্তি প্রকাশ করেছে। উক্ত প্রতিষ্ঠানে বিভিন্ন ক্যাটাগরিতে মোট ৫ টি পদে সরাসরি জনবল নিয়োগের জন্য যোগ্য বাংলাদেশি নাগরিকদের নিকট থেকে অনলাইনে দরখাস্ত আহ্বান করা হচ্ছে।\n\nবিজ্ঞপ্তি অনুযায়ী, এই নিয়োগ প্রক্রিয়ায় ইউনিয়ন পরিষদ প্রশাসনিক কর্মকর্তা (৫ জন) আবেদন গ্রহণ করা হবে। পদভেদে ন্যূনতম শিক্ষাগত যোগ্যতা স্বীকৃত বিশ্ববিদ্যালয় হতে সংশ্লিষ্ট বিষয়ে স্নাতক (সম্মান) বা স্নাতকোত্তর ডিগ্রি নির্ধারণ করা হয়েছে এবং সাধারণ প্রার্থীদের বয়সসীমা ১৮ হতে ৩২ বছরের মধ্যে হতে হবে (বীর মুক্তিযোদ্ধা কোটা ও অন্যান্য সংরক্ষিত কোটায় সরকারি বিধি অনুযায়ী শিথিলযোগ্য)।\n\nনির্বাচিত প্রার্থীরা জাতীয় বেতন স্কেল ২০১৫ এর আওতায় আকর্ষণীয় মূল বেতনের পাশাপাশি সরকারি বিধি মোতাবেক বাড়িভাড়া ভাতা, চিকিৎসা ভাতা, যাতায়াত ভাতা ও উৎসব ভাতা প্রাপ্য হবেন। আগ্রহী প্রার্থীদের নির্ধারিত সময়ের মধ্যে টেলিটকের অফিশিয়াল অনলাইন পোর্টাল (https://dcrajbari.teletalk.com.bd) ব্যবহার করে সঠিক নিয়মে আবেদন ফরম পূরণ ও ফি জমা দেওয়ার পরামর্শ প্রদান করা হচ্ছে।",
      "smsPrefix": "DCRAJBARI",
